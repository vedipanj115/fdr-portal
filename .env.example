# Copy to .env. Everything is optional for a local demo.
PORT=8080
# Demo conveniences (OTP shown on screen, user switcher, time machine, reset). Set to false for a real deployment.
SDFP_DEMO=true
# 32-byte keys as 64 hex characters (openssl rand -hex 32). Generated into ./data on first run if not set.
SDFP_ENC_KEY=
SDFP_JWT_SECRET=
# Real email delivery (otherwise messages go to the local outbox)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=AICTE SDFP <no-reply@example.org>
# Real SMS: the server POSTs {to, text} here
SMS_WEBHOOK=
# Keys for the external services (the mock services accept these)
CBS_API_KEY=demo-cbs-key
AICTE_API_KEY=demo-aicte-key
PG_API_KEY=demo-pg-key
